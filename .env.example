# =============================================================================
# React Vite Frontend - Environment Variables (.env.local)
# =============================================================================
# File ini digunakan untuk sisi klien (browser) pada React.
# Hanya variabel dengan prefix "VITE_" yang dapat diakses melalui import.meta.env
# Salin file ini menjadi ".env.local" untuk penggunaan lokal:
#   cp .env.example .env.local
# PERINGATAN: file ".env.local" sudah di-ignore oleh git. Jangan pernah commit
# nilai aslinya. Anon key memang aman dipublikasikan, tapi tetap best practice
# tidak di-commit.
# ==============================================================================

# ==============================================================================
# SUPABASE (Database + Login/Register)
# ==============================================================================
# Dashboard Supabase -> Project Settings -> API
# - Project URL  -> VITE_SUPABASE_URL
# - anon public key -> VITE_SUPABASE_ANON_KEY
#
# Anon key aman dipakai di browser karena akses data dijaga RLS (Row Level
# Security) di sisi database. JANGAN memakai service_role key di frontend.
# Isi dengan anon key (JWT lama) atau publishable key (sb_publishable_...).
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-key>

# ==============================================================================
# VARIABEL SERVER-SIDE (Pages Functions / wrangler pages dev)
# ==============================================================================
# Ditaruh di .dev.vars saat lokal, dan di Environment Variables Cloudflare
# Pages saat deploy. Key yang dipakai hanya anon/publishable key.
# SUPABASE_URL="https://<project-id>.supabase.co"
# SUPABASE_ANON_KEY="<publishable-key>"

# ==============================================================================
# PENGATURAN APLIKASI UMUM (Opsional)
# ==============================================================================
VITE_APP_NAME="Lethimcook.ai"
VITE_APP_DESCRIPTION="Asisten Rekomendasi Resep Masakan Berbasis AI"
