# ==============================================================================
# Cloudflare Pages Functions - Local Environment Variables (.dev.vars)
# ==============================================================================
# File ini digunakan untuk Pages Functions (sisi server, folder /functions).
# Salin file ini menjadi ".dev.vars" untuk penggunaan lokal:
#   cp .dev.vars.example .dev.vars
# PERINGATAN: Jangan pernah commit file ".dev.vars" yang berisi API key asli ke git!
# ==============================================================================

# ==============================================================================
# LLM (OpenAI-compatible) — default: 9router
# ==============================================================================
# 1. API Key dari penyedia LLM pilihan Anda (Wajib)
# Untuk 9router: key diambil dari tabel "apiKeys" di
#    %APPDATA%/9router/db/data.sqlite  (ada "Default Key" dan "hermes")
#    auth\cli-secret BUKAN api key.
LLM_API_KEY="isi-api-key-9router"

# 2. Base URL endpoint LLM API
# - 9router lokal:  http://127.0.0.1:20128/v1
# - 9router AWS:    http://<host-publik>:20128/v1   (dipakai untuk produksi)
# - OpenAI:        https://api.openai.com/v1
# - Gemini (OpenAI Compat): https://generativelanguage.googleapis.com/v1beta/openai
# - OpenRouter:    https://openrouter.ai/api/v1
# - Groq:           https://api.groq.com/openai/v1
LLM_BASE_URL="http://127.0.0.1:20128/v1"

# 3. Model Vision yang digunakan untuk mengenali gambar makanan / bahan
# - 9router: "ngoding-aaa"  (alias combo -> model vision, mis. deepseek-v4.1-flash)
# - OpenAI: "gpt-4o-mini"
# - Gemini: "gemini-2.0-flash"
# - OpenRouter: "google/gemini-2.0-flash-exp:free"
LLM_MODEL="ngoding-aaa"

# Catatan: 9router membalas content-type text/event-stream (JSON + trailer
# "data: [DONE]"). Jangan parse dengan res.json() langsung -> pakai
# parseProviderPayload() di functions/_shared/analyze.ts.

# ==============================================================================
# SUPABASE (Sisi Server / Opsional untuk Pages Functions)
# ==============================================================================
# Digunakan jika Cloudflare Pages Function membutuhkan akses bypass RLS (Service Role):
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
