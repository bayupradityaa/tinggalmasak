# ==============================================================================
# Cloudflare Pages Functions - Local Environment Variables (.dev.vars)
# ==============================================================================
# File ini digunakan untuk Pages Functions (sisi server, folder /functions).
# Salin file ini menjadi ".dev.vars" untuk penggunaan lokal:
#   cp .dev.vars.example .dev.vars
# PERINGATAN: Jangan pernah commit file ".dev.vars" yang berisi API key asli ke git!
# ==============================================================================

# 1. API Key dari penyedia LLM pilihan Anda (Wajib)
LLM_API_KEY="sk-your-api-key-here"

# 2. Base URL endpoint LLM API (Default: OpenAI standard endpoint)
# Pilihan endpoint populer yang kompatibel dengan format OpenAI Vision:
# - OpenAI: https://api.openai.com/v1
# - Google Gemini (OpenAI Compat): https://generativelanguage.googleapis.com/v1beta/openai
# - OpenRouter: https://openrouter.ai/api/v1
# - Groq: https://api.groq.com/openai/v1
LLM_BASE_URL="https://api.openai.com/v1"

# 3. Model Vision yang digunakan untuk mengenali gambar makanan / bahan
# Rekomendasi model cepat dan hemat biaya:
# - OpenAI: "gpt-4o-mini"
# - Google Gemini: "gemini-1.5-flash" atau "gemini-2.0-flash"
# - OpenRouter: "google/gemini-2.0-flash-exp:free" atau "meta-llama/llama-3.2-11b-vision-instruct:free"
# - Groq: "llama-3.2-11b-vision-preview"
LLM_MODEL="gpt-4o-mini"

# ==============================================================================
# SUPABASE (Sisi Server / Opsional untuk Pages Functions)
# ==============================================================================
# Digunakan jika Cloudflare Pages Function membutuhkan akses bypass RLS (Service Role):
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
